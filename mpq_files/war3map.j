//===========================================================================
function Trig_Prevent_Attack_Conditions takes nothing returns boolean
    if ( not ( GetOwningPlayer(GetAttacker()) == Player(11) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Prevent_Attack_Actions takes nothing returns nothing
    call TriggerSleepAction( 1.00 )
    call IssuePointOrderLocBJ( GetAttacker(), "move", GetRectCenter(gg_rct_Load) )
endfunction

//===========================================================================
function InitTrig_Prevent_Attack takes nothing returns nothing
    set gg_trg_Prevent_Attack = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Prevent_Attack, Player(0), EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Prevent_Attack, Player(1), EVENT_PLAYER_UNIT_ATTACKED )
