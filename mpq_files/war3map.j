//===========================================================================
// Trigger: Unit Board Ship
//===========================================================================
function Trig_Unit_Board_Ship_Conditions takes nothing returns boolean
    if ( not ( udg_Level_Number <= 30 ) ) then
        return false
    endif
    if ( not ( GetOwningPlayer(GetEnteringUnit()) == Player(11) ) ) then
        return false
    endif
    return true
endfunction

function Trig_Unit_Board_Ship_Func002001 takes nothing returns boolean
    return ( GetUnitTypeId(GetEnteringUnit()) == 'uC72' )
endfunction

function Trig_Unit_Board_Ship_Func002002002 takes nothing returns nothing
    call CustomDefeatBJ( GetEnumPlayer(), "TRIGSTR_434" )
endfunction

function Trig_Unit_Board_Ship_Func003001 takes nothing returns boolean
    return ( GetUnitTypeId(GetEnteringUnit()) == 'uC72' )
endfunction

function Trig_Unit_Board_Ship_Actions takes nothing returns nothing
    if ( Trig_Unit_Board_Ship_Func002001() ) then
        call ForForce( udg_Defenders, function Trig_Unit_Board_Ship_Func002002002 )
    else
        call DoNothing(  )
    endif
    if ( Trig_Unit_Board_Ship_Func003001() ) then
        return
    else
        call DoNothing(  )
    endif
    set udg_Lives = ( udg_Lives - 1 )
    set udg_Lives_Lost = ( udg_Lives_Lost + 1 )
    set udg_NoLivesLost = false
    call DisplayTextToForce( GetPlayersAll(), ( "|c00ff0000A unit has boarded the ship! |r" + ( I2S(udg_Lives) + " |c00ff0000chances left|r" ) ) )
    call RemoveUnit( GetEnteringUnit() )
    call PlaySoundBJ( gg_snd_Loading )
endfunction

