    return ( udg_Level_Number == 20 )
endfunction

function Trig_Gold_and_Tips_Func015001 takes nothing returns boolean
    return ( udg_Level_Number == 15 )
endfunction

function Trig_Gold_and_Tips_Func016001 takes nothing returns boolean
    return ( udg_Level_Number == 15 )
endfunction

function Trig_Gold_and_Tips_Func016002002 takes nothing returns nothing
    call AdjustPlayerStateBJ( 1, GetEnumPlayer(), PLAYER_STATE_RESOURCE_LUMBER )
endfunction

function Trig_Gold_and_Tips_Actions takes nothing returns nothing
    // Player Gold & Player 9 Extra Gold
    call ForForce( udg_Defenders, function Trig_Gold_and_Tips_Func004002 )
    call DisplayTextToForce( GetPlayersAll(), ( ( "|c0000cdf9You recieved |r" + I2S(udg_Gold_Amount) ) + ( "|c0000cdf9 extra gold for completing level |r" + I2S(( udg_Level_Number - 1 )) ) ) )
    if ( Trig_Gold_and_Tips_Func006001() ) then
        call DisplayTextToForce( GetPlayersAll(), ( GetPlayerName(Player(8)) + ( ( " " + "recieved " ) + ( I2S(( udg_Gold_Amount / 2 )) + " additional gold for being the last defender" ) ) ) )
    else
        call DoNothing(  )
    endif
    // Bounty Comment
    call TriggerSleepAction( 15.00 )
    if ( Trig_Gold_and_Tips_Func009001() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_397" )
    else
        call DoNothing(  )
    endif
    if ( Trig_Gold_and_Tips_Func010001() ) then
        call AdjustPlayerStateBJ( ( udg_Gold_Amount / 2 ), Player(8), PLAYER_STATE_RESOURCE_GOLD )
    else
        call DoNothing(  )
    endif
    if ( Trig_Gold_and_Tips_Func011001() ) then
        call PlaySoundBJ( gg_snd_Hint )
    else
        call DoNothing(  )
    endif
    if ( Trig_Gold_and_Tips_Func012001() ) then
        call PlaySoundBJ( gg_snd_Hint )
    else
        call DoNothing(  )
    endif
    if ( Trig_Gold_and_Tips_Func013001() ) then
        call PlaySoundBJ( gg_snd_Hint )
    else
        call DoNothing(  )
    endif
    // Lumber
    if ( Trig_Gold_and_Tips_Func015001() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_500" )
    else
        call DoNothing(  )
    endif
    if ( Trig_Gold_and_Tips_Func016001() ) then
        call ForForce( udg_Defenders, function Trig_Gold_and_Tips_Func016002002 )
    else
        call DoNothing(  )
    endif
    // Random Tip
    call TriggerSleepAction( 10.00 )
    call DisplayTimedTextToForce( GetPlayersAll(), 10.00, udg_Tip[GetRandomInt(1, 30)] )
endfunction

//===========================================================================
function InitTrig_Gold_and_Tips takes nothing returns nothing
    set gg_trg_Gold_and_Tips = CreateTrigger(  )
    call DisableTrigger( gg_trg_Gold_and_Tips )
    call TriggerAddCondition( gg_trg_Gold_and_Tips, Condition( function Trig_Gold_and_Tips_Conditions ) )
    call TriggerAddAction( gg_trg_Gold_and_Tips, function Trig_Gold_and_Tips_Actions )
endfunction

