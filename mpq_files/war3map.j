function Trig_Player_1_Conditions takes nothing returns boolean
    if ( not ( GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_LEFT ) ) then
        return false
    endif
    return true
endfunction

function Trig_Player_1_Func004002 takes nothing returns nothing
    call SetUnitOwner( GetEnumUnit(), ForcePickRandomPlayer(udg_Defenders), true )
endfunction

function Trig_Player_1_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call DisplayTimedTextToForce( GetPlayersAll(), 25.00, ( GetPlayerName(Player(0)) + "|c0000cdf9 has left the game|r" ) )
    call ForceRemovePlayerSimple( Player(0), udg_Defenders )
    call ForGroupBJ( GetUnitsInRectOfPlayer(GetPlayableMapRect(), Player(0)), function Trig_Player_1_Func004002 )
    call LeaderboardSetPlayerItemLabelBJ( Player(0), GetLastCreatedLeaderboard(), "TRIGSTR_203" )
endfunction

