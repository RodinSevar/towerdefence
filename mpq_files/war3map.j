//===========================================================================
// Trigger: Startup Movement
//===========================================================================
function Trig_Startup_Movement_Func002002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_LeftSide )
endfunction

function Trig_Startup_Movement_Func003002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_LeftSide )
endfunction

function Trig_Startup_Movement_Func004002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Middle_LeftSide )
endfunction

function Trig_Startup_Movement_Func005002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Middle_RightSide )
endfunction

function Trig_Startup_Movement_Func006002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_RightSide )
endfunction

function Trig_Startup_Movement_Func007002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_RightSide )
endfunction

function Trig_Startup_Movement_Func008002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Bottom_left )
endfunction

function Trig_Startup_Movement_Func009002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Bottom_Right )
endfunction

function Trig_Startup_Movement_Func010002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Bottom_left )
endfunction

function Trig_Startup_Movement_Func011002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Bottom_left )
endfunction

function Trig_Startup_Movement_Func012002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Bottom_Right )
endfunction

function Trig_Startup_Movement_Func013002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Bottom_Right )
endfunction

function Trig_Startup_Movement_Func014002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Middle_LeftSide )
endfunction

function Trig_Startup_Movement_Func015002 takes nothing returns nothing
    call GroupAddUnitSimple( GetEnumUnit(), udg_Attackers_Middle_RightSide )
endfunction

function Trig_Startup_Movement_Actions takes nothing returns nothing
    // Put Units into Groups
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Left_Spawn, Player(11)), function Trig_Startup_Movement_Func002002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Left_Spawn_2, Player(11)), function Trig_Startup_Movement_Func003002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Middle_Left_Spawn, Player(11)), function Trig_Startup_Movement_Func004002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Middle_Right_Spawn, Player(11)), function Trig_Startup_Movement_Func005002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Right_Spawn, Player(11)), function Trig_Startup_Movement_Func006002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Right_Spawn_2, Player(11)), function Trig_Startup_Movement_Func007002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Bottom_Left_Spawn, Player(11)), function Trig_Startup_Movement_Func008002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_Bottom_Right_Spawn, Player(11)), function Trig_Startup_Movement_Func009002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_orange_lower, Player(11)), function Trig_Startup_Movement_Func010002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_orange_upper, Player(11)), function Trig_Startup_Movement_Func011002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_purp_lower, Player(11)), function Trig_Startup_Movement_Func012002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_purp_upper, Player(11)), function Trig_Startup_Movement_Func013002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_yellow_left, Player(11)), function Trig_Startup_Movement_Func014002 )
    call ForGroupBJ( GetUnitsInRectOfPlayer(gg_rct_yellow_right, Player(11)), function Trig_Startup_Movement_Func015002 )
    // Order Move
    call TriggerExecute( gg_trg_Move_Left )
    call TriggerExecute( gg_trg_Move_Middle_Left )
    call TriggerExecute( gg_trg_Move_Middle_Right )
    call TriggerExecute( gg_trg_Move_Right )
    call TriggerExecute( gg_trg_Move_Bottom_Left )
    call TriggerExecute( gg_trg_Move_Bottom_Right )
endfunction

//===========================================================================
function InitTrig_Startup_Movement takes nothing returns nothing
    set gg_trg_Startup_Movement = CreateTrigger(  )
    call DisableTrigger( gg_trg_Startup_Movement )
    call TriggerAddAction( gg_trg_Startup_Movement, function Trig_Startup_Movement_Actions )
endfunction

