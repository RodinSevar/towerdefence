//===========================================================================
// Trigger: IntDifficulty
//===========================================================================
function Trig_IntDifficulty_Actions takes nothing returns nothing
    call DialogSetMessageBJ( udg_DiffDialog, "TRIGSTR_509" )
    call DialogAddButtonBJ( udg_DiffDialog, "TRIGSTR_1040" )
    set udg_VeryEasy = GetLastCreatedButtonBJ()
    call DialogAddButtonBJ( udg_DiffDialog, "TRIGSTR_510" )
    set udg_Easy = GetLastCreatedButtonBJ()
    call DialogAddButtonBJ( udg_DiffDialog, "TRIGSTR_511" )
    set udg_Normal = GetLastCreatedButtonBJ()
    call DialogAddButtonBJ( udg_DiffDialog, "TRIGSTR_512" )
    set udg_Hard = GetLastCreatedButtonBJ()
    call DialogAddButtonBJ( udg_DiffDialog, "TRIGSTR_513" )
    set udg_Perfection = GetLastCreatedButtonBJ()
    call DialogDisplayBJ( true, udg_DiffDialog, Player(0) )
    call DisplayTimedTextToForce( GetPlayersAll(), 29.00, "TRIGSTR_518" )
    call TriggerSleepAction( 30.00 )
    call DialogDisplayBJ( false, udg_DiffDialog, Player(0) )
endfunction

//===========================================================================
function InitTrig_IntDifficulty takes nothing returns nothing
    set gg_trg_IntDifficulty = CreateTrigger(  )
    call TriggerRegisterTimerEventSingle( gg_trg_IntDifficulty, 1.00 )
    call TriggerAddAction( gg_trg_IntDifficulty, function Trig_IntDifficulty_Actions )
endfunction

