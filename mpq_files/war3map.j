//===========================================================================
function InitTrig_Set_Levels takes nothing returns nothing
    set gg_trg_Set_Levels = CreateTrigger(  )
    call DisableTrigger( gg_trg_Set_Levels )
    call TriggerAddCondition( gg_trg_Set_Levels, Condition( function Trig_Set_Levels_Conditions ) )
    call TriggerAddAction( gg_trg_Set_Levels, function Trig_Set_Levels_Actions )
endfunction

//===========================================================================
// Trigger: Defeat
//===========================================================================
function Trig_Defeat_Conditions takes nothing returns boolean
    if ( not ( udg_Lives <= 0 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Defeat_Func003002 takes nothing returns nothing
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_Defeat_Func007002 takes nothing returns nothing
    call CustomDefeatBJ( GetEnumPlayer(), "TRIGSTR_080" )
endfunction

function Trig_Defeat_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    set udg_Defeat = true
    call ForGroupBJ( GetUnitsInRectAll(GetPlayableMapRect()), function Trig_Defeat_Func003002 )
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_077" )
    call DisableTrigger( gg_trg_Unit_Board_Ship )
    call TriggerSleepAction( 5.00 )
    call ForForce( udg_Defenders, function Trig_Defeat_Func007002 )
endfunction

//===========================================================================
function InitTrig_Defeat takes nothing returns nothing
    set gg_trg_Defeat = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Defeat, 0.50 )
    call TriggerAddCondition( gg_trg_Defeat, Condition( function Trig_Defeat_Conditions ) )
    call TriggerAddAction( gg_trg_Defeat, function Trig_Defeat_Actions )
endfunction

//===========================================================================
// Trigger: Sell
//===========================================================================
function Trig_Sell_Conditions takes nothing returns boolean
    if ( not ( GetUnitTypeId(GetTrainedUnit()) == 'nC57' ) ) then
        return false
    endif
    return true
endfunction

function Trig_Sell_Actions takes nothing returns nothing
    call AddSpecialEffectLocBJ( GetUnitLoc(GetTriggerUnit()), "Abilities\\Spells\\Human\\HolyBolt\\HolyBoltSpecialArt.mdl" )
    call RemoveUnit( GetTriggerUnit() )
    call RemoveUnit( GetTrainedUnit() )
    call AdjustPlayerStateBJ( GetUnitPointValue(GetTriggerUnit()), GetOwningPlayer(GetTrainedUnit()), PLAYER_STATE_RESOURCE_GOLD )
    call DisplayTextToForce( GetForceOfPlayer(GetOwningPlayer(GetTrainedUnit())), ( ( "|c0000cdf9You recieved |r" + I2S(GetUnitPointValue(GetTriggerUnit())) ) + ( "|c0000cdf9 gold for selling a |r" + GetUnitName(GetTriggerUnit()) ) ) )
endfunction

//===========================================================================
function InitTrig_Sell takes nothing returns nothing
    set gg_trg_Sell = CreateTrigger(  )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(0), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(1), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(2), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(3), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(4), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(5), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(6), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(7), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Sell, Player(8), EVENT_PLAYER_UNIT_TRAIN_FINISH )
    call TriggerAddCondition( gg_trg_Sell, Condition( function Trig_Sell_Conditions ) )
    call TriggerAddAction( gg_trg_Sell, function Trig_Sell_Actions )
endfunction

//===========================================================================
// Trigger: Victory
//===========================================================================
function Trig_Victory_Conditions takes nothing returns boolean
    if ( not ( udg_Lives > 0 ) ) then
        return false
    endif
    if ( not ( udg_Level_Number == 50 ) ) then
        return false
    endif
    return true
endfunction

function Trig_Victory_Func002002 takes nothing returns nothing
    call RemoveUnit( GetEnumUnit() )
endfunction

function Trig_Victory_Func004002 takes nothing returns nothing
    call CustomVictoryBJ( GetEnumPlayer(), true, true )
endfunction

function Trig_Victory_Actions takes nothing returns nothing
    call DisableTrigger( GetTriggeringTrigger() )
    call ForGroupBJ( GetUnitsInRectOfPlayer(GetPlayableMapRect(), Player(11)), function Trig_Victory_Func002002 )
    call DisableTrigger( gg_trg_Unit_Board_Ship )
    call ForForce( GetPlayersAll(), function Trig_Victory_Func004002 )
endfunction

//===========================================================================
function InitTrig_Victory takes nothing returns nothing
    set gg_trg_Victory = CreateTrigger(  )
    call TriggerRegisterTimerEventPeriodic( gg_trg_Victory, 0.50 )
    call TriggerAddCondition( gg_trg_Victory, Condition( function Trig_Victory_Conditions ) )
    call TriggerAddAction( gg_trg_Victory, function Trig_Victory_Actions )
endfunction

//===========================================================================
// Trigger: Set Tips
//===========================================================================
function Trig_Set_Tips_Actions takes nothing returns nothing
    set udg_Tip[1] = "|c0000ff00Tip 1 of 30|r - |c0000cdf9Never block with towers, it will cause units to run down a different path or attack|r"
    set udg_Tip[2] = "|c0000ff00Tip 2 of 30|r - |c0000cdf9It's always good to have at least one person using each element, they will benefit eachother|r"
    set udg_Tip[3] = "|c0000ff00Tip 3 of 30|r - |c0000cdf9If you find a bug or have a suggestion, whisper to me (dukewintermaul)"
    set udg_Tip[4] = "|c0000ff00Tip 4 of 30|r - |c0000cdf9Attackers require atleast one square to move through.|r"
    set udg_Tip[5] = "|c0000ff00Tip 5 of 30|r - |c0000cdf9Air levels are 5, 14, 23 and 27|r"
    set udg_Tip[6] = "|c0000ff00Tip 6 of 30|r - |c0000cdf9Level 17 is a very difficult level, be ready!|r"
    set udg_Tip[7] = "|c0000ff00Tip 7 of 30|r - |c0000cdf9Ion Cannon Centers will not do the extra 500 damage if the unit being attacked has less than 500 hp|r"
    set udg_Tip[8] = "|c0000ff00Tip 8 of 30|r - |c0000cdf9If a tower is damaged, don't bother to sell it. Damage is only a consmedic thing|r"
    set udg_Tip[9] = "|c0000ff00Tip 9 of 30|r - |c0000cdf9At level 15, you get ONE more piece of lumber, don't forget you have it!|r"
    set udg_Tip[10] = "|c0000ff00Tip 10 of 30|r - |c0000cdf9Most of the time, selling is not the best choice. Simply waiting will get you the extra money|r"
    set udg_Tip[11] = "|c0000ff00Tip 11 of 30|r - |c0000cdf9Don't build in another person's area|r"
    set udg_Tip[12] = "|c0000ff00Tip 12 of 30|r - |c0000cdf9If someone is leaking, build behind them, do not build in front of their base, they need as many kills as possible|r"
    set udg_Tip[13] = "|c0000ff00Tip 13 of 30|r - |c0000cdf9Every element has it's strengths and weaknesses, try a different one each time|r"
    set udg_Tip[14] = "|c0000ff00Tip 14 of 30|r - |c0000cdf9Mazing is very important, try and give more powerful towers more exposure|r"
    set udg_Tip[15] = "|c0000ff00Tip 15 of 30|r - |c0000cdf9Certain elements are particularly good for mazing, mainly Tech, Ice, and Electricity|r"
    set udg_Tip[16] = "|c0000ff00Tip 16 of 30|r - |c0000cdf9Certain elements are always a good idea to have, mainly ice and poison|r"
    set udg_Tip[17] = "|c0000ff00Tip 17 of 30|r - |c0000cdf9Green, pink, and gray should save their second piece of wood for a Laser Cannon.|r"
    set udg_Tip[18] = "|c0000ff00Tip 18 of 30|r - |c0000cdf9The Laser Cannon is the best tower in the game, however, only gray, green, and pink can build it |r"
    set udg_Tip[19] = "|c0000ff00Tip 19 of 30|r - |c0000cdf9The Laser Cannon is devistating no matter where it is, try pooling money to gray, pink or green to get a Laser Cannon.|r"
    set udg_Tip[20] = "|c0000ff00Tip 20 of 30|r - |c0000cdf9The Laser Cannon is built at the Elemental Chooser but only gray, pink and green can build it, and it costs a piece of lumber|r"
    set udg_Tip[21] = "|c0000ff00Tip 21 of 30|r - |c0000cdf9Sometimes selling a bunch of towers to get a more powerful one can be a mistake|r"
    set udg_Tip[22] = "|c0000ff00Tip 22 of 30|r - |c0000cdf9Type -help to read the \"help\" information about the map at any time|r"
    set udg_Tip[23] = "|c0000ff00Tip 23 of 30|r - |c0000cdf9Always try and have the newest version, it can be found at www.warcraftiii.net in the Maps 'n' Mods section and at Warcraft.org Map Databaselr"
    set udg_Tip[24] = "|c0000ff00Tip 24 of 30|r - |c0000cdf9Play Wintermaul TD often ^^|r"
    set udg_Tip[25] = "|c0000ff00Tip 25 of 30|r - |c0000cdf9Sometimes building a maze with another player can be very effective|r"
    set udg_Tip[26] = "|c0000ff00Tip 26 of 30|r - |c0000cdf9The Bonus levels are meant to be strange and humorous. Don't send me e-mails about level 33 :P|r"
    set udg_Tip[27] = "|c0000ff00Tip 27 of 30|r - |c0000cdf9You should have atleast three servings of vegetables a day :P|r"
    set udg_Tip[28] = "|c0000ff00Tip 28 of 30|r - |c0000cdf9MANY thanks to all the crappy TDs before this one, they inspired me to create a truly great one|r"
    set udg_Tip[29] = "|c0000ff00Tip 29 of 30|r - |c0000cdf9Thanks for playing Wintermaul TD, rehost this map if you can|r"
    set udg_Tip[30] = "|c0000ff00Tip 30 of 30|r - |c0000cdf9Remember this when angry at newbies, everyone was a newbie once...|r"
endfunction

