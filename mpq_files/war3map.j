    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Prevent_Attack, Player(6), EVENT_PLAYER_UNIT_ATTACKED )
    call TriggerRegisterPlayerUnitEventSimple( gg_trg_Prevent_Attack, Player(7), EVENT_PLAYER_UNIT_ATTACKED )
