function Trig_Middle_Func002001 takes nothing returns boolean
    return ( IsUnitInGroup(GetEnteringUnit(), udg_Attackers_Middle_RightSide) == true )
endfunction

function Trig_Middle_Actions takes nothing returns nothing
    if ( Trig_Middle_Func001001() ) then
        call IssuePointOrderLocBJ( GetEnteringUnit(), "move", GetRectCenter(gg_rct_Left_Move_0_Order) )
    else
        call DoNothing(  )
    endif
    if ( Trig_Middle_Func002001() ) then
        call IssuePointOrderLocBJ( GetEnteringUnit(), "move", GetRectCenter(gg_rct_Right_Move_0_Order) )
    else
        call DoNothing(  )
    endif
endfunction

