function InitTrig_Unit_Board_Ship takes nothing returns nothing
    set gg_trg_Unit_Board_Ship = CreateTrigger(  )
    call TriggerRegisterEnterRectSimple( gg_trg_Unit_Board_Ship, gg_rct_Load )
    call TriggerAddCondition( gg_trg_Unit_Board_Ship, Condition( function Trig_Unit_Board_Ship_Conditions ) )
    call TriggerAddAction( gg_trg_Unit_Board_Ship, function Trig_Unit_Board_Ship_Actions )
endfunction

