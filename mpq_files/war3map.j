//===========================================================================
// Trigger: Core Funtion
//===========================================================================
function Trig_Core_Funtion_Conditions takes nothing returns boolean
    if ( not ( udg_Defeat == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Core_Funtion_Func023001 takes nothing returns boolean
    return ( udg_Level_Number == 30 )
endfunction

function Trig_Core_Funtion_Func028002 takes nothing returns nothing
    call SetUnitAcquireRangeBJ( GetEnumUnit(), 0.00 )
endfunction

function Trig_Core_Funtion_Actions takes nothing returns nothing
    // Setup Timer
    call PauseTimerBJ( true, udg_Next_Level )
    call DestroyTimerDialogBJ( GetLastCreatedTimerDialogBJ() )
    // Create Units
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Left_Spawn), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Left_Spawn_2), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Middle_Left_Spawn), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Middle_Right_Spawn), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Right_Spawn), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Right_Spawn_2), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Bottom_Left_Spawn), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Bottom_Right_Spawn), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_orange_lower), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_orange_upper), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_purp_lower), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_purp_upper), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_yellow_left), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( 1, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_yellow_right), bj_UNIT_FACING )
    call CreateNUnitsAtLoc( udg_Monster_Amount, udg_Monster_Type, Player(11), GetRectCenter(gg_rct_Left_Move_2), bj_UNIT_FACING )
    // Level Info
    if ( Trig_Core_Funtion_Func023001() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_706" )
    else
        call DoNothing(  )
    endif
    call DisplayTextToForce( GetPlayersAll(), ( ( "Level " + I2S(udg_Level_Number) ) + ( " - " + ( GetUnitName(GetLastCreatedUnit()) + "s" ) ) ) )
    // Run Triggers
    call ConditionalTriggerExecute( gg_trg_Startup_Movement )
    // Misc.
    call ForGroupBJ( GetUnitsOfPlayerAll(Player(11)), function Trig_Core_Funtion_Func028002 )
endfunction

//===========================================================================
function InitTrig_Core_Funtion takes nothing returns nothing
    set gg_trg_Core_Funtion = CreateTrigger(  )
    call TriggerRegisterTimerExpireEventBJ( gg_trg_Core_Funtion, udg_Next_Level )
    call TriggerAddCondition( gg_trg_Core_Funtion, Condition( function Trig_Core_Funtion_Conditions ) )
    call TriggerAddAction( gg_trg_Core_Funtion, function Trig_Core_Funtion_Actions )
endfunction

//===========================================================================
// Trigger: Next Level
//===========================================================================
function Trig_Next_Level_Conditions takes nothing returns boolean
    if ( not ( udg_Defeat == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Next_Level_Func005001001 takes nothing returns boolean
    return ( udg_NoLivesLost == true )
endfunction

function Trig_Next_Level_Func005001002 takes nothing returns boolean
    return ( udg_Level_Number >= 1 )
endfunction

function Trig_Next_Level_Func005001 takes nothing returns boolean
    return GetBooleanAnd( Trig_Next_Level_Func005001001(), Trig_Next_Level_Func005001002() )
endfunction

function Trig_Next_Level_Func005003001 takes nothing returns boolean
    return ( udg_Level_Number >= 1 )
endfunction

function Trig_Next_Level_Func010001 takes nothing returns boolean
    return ( udg_Level_Number == 1 )
endfunction

function Trig_Next_Level_Func013001 takes nothing returns boolean
    return ( udg_Level_Number == 1 )
endfunction

function Trig_Next_Level_Func015001 takes nothing returns boolean
    return ( udg_Level_Number == 32 )
endfunction

function Trig_Next_Level_Actions takes nothing returns nothing
    // Gold Change
    set udg_Gold_Amount = ( udg_Gold_Amount + 2 )
    // Lives Comment
    if ( Trig_Next_Level_Func005001() ) then
        call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_128" )
    else
        if ( Trig_Next_Level_Func005003001() ) then
            call DisplayTextToForce( GetPlayersAll(), ( I2S(udg_Lives_Lost) + "|c0000cdf9 chances have been lost|r" ) )
        else
            call DoNothing(  )
        endif
    endif
    // Level Setup
    set udg_Level_Number = ( udg_Level_Number + 1 )
    call ConditionalTriggerExecute( gg_trg_Update_Title )
    // Timer
    if ( Trig_Next_Level_Func010001() ) then
        call StartTimerBJ( udg_Next_Level, false, 60.00 )
    else
        call StartTimerBJ( udg_Next_Level, false, 30 )
    endif
    call CreateTimerDialogBJ( GetLastCreatedTimerBJ(), ( ( "Level " + I2S(udg_Level_Number) ) + " in..." ) )
    // Set Next Level
    if ( Trig_Next_Level_Func013001() ) then
        call TriggerSleepAction( 29.50 )
    else
        call DoNothing(  )
    endif
    call DisplayTextToForce( GetPlayersAll(), "TRIGSTR_061" )
    if ( Trig_Next_Level_Func015001() ) then
        call DisplayTimedTextToForce( GetPlayersAll(), 30.00, "TRIGSTR_661" )
    else
        call DoNothing(  )
    endif
    call ConditionalTriggerExecute( gg_trg_Set_Levels )
    call ConditionalTriggerExecute( gg_trg_Gold_and_Tips )
endfunction

//===========================================================================
function InitTrig_Next_Level takes nothing returns nothing
    set gg_trg_Next_Level = CreateTrigger(  )
    call TriggerRegisterPlayerStateEvent( gg_trg_Next_Level, Player(11), PLAYER_STATE_RESOURCE_FOOD_USED, LESS_THAN_OR_EQUAL, 0.00 )
    call TriggerAddCondition( gg_trg_Next_Level, Condition( function Trig_Next_Level_Conditions ) )
    call TriggerAddAction( gg_trg_Next_Level, function Trig_Next_Level_Actions )
endfunction

//===========================================================================
// Trigger: Gold and Tips
//===========================================================================
function Trig_Gold_and_Tips_Conditions takes nothing returns boolean
    if ( not ( CountUnitsInGroup(GetUnitsInRectAll(GetPlayableMapRect())) == 0 ) ) then
        return false
    endif
    if ( not ( udg_Defeat == false ) ) then
        return false
    endif
    return true
endfunction

function Trig_Gold_and_Tips_Func004002 takes nothing returns nothing
    call AdjustPlayerStateBJ( udg_Gold_Amount, GetEnumPlayer(), PLAYER_STATE_RESOURCE_GOLD )
endfunction

function Trig_Gold_and_Tips_Func006001 takes nothing returns boolean
    return ( GetPlayerSlotState(Player(8)) == PLAYER_SLOT_STATE_PLAYING )
endfunction

function Trig_Gold_and_Tips_Func009001001 takes nothing returns boolean
    return ( udg_Level_Number == 5 )
endfunction

function Trig_Gold_and_Tips_Func009001002001 takes nothing returns boolean
    return ( udg_Level_Number == 15 )
endfunction

function Trig_Gold_and_Tips_Func009001002002 takes nothing returns boolean
    return ( udg_Level_Number == 20 )
endfunction

function Trig_Gold_and_Tips_Func009001002 takes nothing returns boolean
    return GetBooleanOr( Trig_Gold_and_Tips_Func009001002001(), Trig_Gold_and_Tips_Func009001002002() )
endfunction

function Trig_Gold_and_Tips_Func009001 takes nothing returns boolean
    return GetBooleanOr( Trig_Gold_and_Tips_Func009001001(), Trig_Gold_and_Tips_Func009001002() )
endfunction

function Trig_Gold_and_Tips_Func010001 takes nothing returns boolean
    return ( GetPlayerSlotState(Player(8)) == PLAYER_SLOT_STATE_PLAYING )
endfunction

